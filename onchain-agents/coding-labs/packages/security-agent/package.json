{
  "name": "@coding-labs/security-agent",
  "version": "0.1.0",
  "description": "A2A agent for security auditing, vulnerability scanning, and protocol risk assessment",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "pnpm exec tsc",
    "start": "node dist/index.js",
    "clean": "rm -rf dist node_modules",
    "typecheck": "pnpm exec tsc --noEmit"
  },
  "keywords": [
    "security",
    "audit",
    "vulnerability",
    "a2a",
    "agent",
    "blockchain",
    "smart-contract"
  ],
  "dependencies": {
    "@a2a-js/sdk": "^0.3.10",
    "@ai-sdk/google-vertex": "^3.0.98",
    "@coding-labs/shared": "workspace:*",
    "ai": "^5.0.0",
    "cors": "^2.8.6",
    "express": "^4.21.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
