# Security Agent - Container Build
# Multi-stage build for smaller final image

# ==============================================================================
# Stage 1: Build
# ==============================================================================
FROM node:20-slim AS builder

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy workspace configuration
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY tsconfig.base.json ./

# Copy shared package
COPY packages/shared ./packages/shared

# Copy security-agent package
COPY packages/security-agent ./packages/security-agent

# Install dependencies
RUN pnpm install --frozen-lockfile

# Build shared package first, then security-agent
RUN pnpm --filter @coding-labs/shared build
RUN pnpm --filter @coding-labs/security-agent build

# ==============================================================================
# Stage 2: Production
# ==============================================================================
FROM node:20-slim AS production

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy workspace files
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./

# Copy built packages
COPY --from=builder /app/packages/shared/package.json ./packages/shared/
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist

COPY --from=builder /app/packages/security-agent/package.json ./packages/security-agent/
COPY --from=builder /app/packages/security-agent/dist ./packages/security-agent/dist
COPY --from=builder /app/packages/security-agent/SKILLS.md ./packages/security-agent/

# Copy config.toml for configuration loading
COPY config.toml ./

# Install production dependencies only
RUN pnpm install --frozen-lockfile --prod

# Set environment
# Note: Cloud Run sets PORT=8080 automatically
ENV NODE_ENV=production
ENV SECURITY_AGENT_HOST=0.0.0.0
ENV SECURITY_AGENT_PORT=8080

EXPOSE 8080

WORKDIR /app/packages/security-agent

# Health check - uses PORT env var (8080 for Cloud Run, 4006 for local)
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD node -e "fetch('http://localhost:' + (process.env.PORT || 8080) + '/health').then(r => r.ok ? process.exit(0) : process.exit(1)).catch(() => process.exit(1))"

CMD ["node", "dist/index.js"]
